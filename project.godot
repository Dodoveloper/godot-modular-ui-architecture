; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="modular-ui-architecture"
run/main_scene="uid://bjlrobvsqx3gj"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

GdlrModuleManager="*uid://b6ecuid2detu8"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"

[editor_plugins]

enabled=PackedStringArray("res://addons/godular/plugin.cfg")

[file_customization]

folder_colors={
"res://addons/": "blue",
"res://addons/modular_ui_architecture/modules/": "red",
"res://addons/modular_ui_architecture/modules/tooltips/ui/": "green",
"res://addons/modular_ui_architecture/shared/": "yellow",
"res://demo/": "purple",
"res://demo/assets/": "pink",
"res://demo/modules/": "red"
}

[godular]

editor_root_module_path=""

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
